# Copy to .env and reference from docker-compose.yml (env_file: .env)
# All settings are optional.

# Run as this user inside the container (Unraid default: 99/100)
PUID=99
PGID=100

# Auto-generates and persists in /app/data/.secret_key if unset
FLASK_SECRET_KEY=

# Set to 1 when running behind a reverse proxy (nginx, SWAG, NPM, Traefik)
TRUSTED_PROXY=

# Set to 1 when serving over HTTPS (marks cookies Secure)
COOKIE_SECURE=

# SMTP — enables welcome emails, recipe sharing by email, password resets
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS=true
